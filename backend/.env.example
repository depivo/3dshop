# Логин админки
ADMIN_USERNAME=admin
# bcrypt-хэш пароля админки. Сгенерировать:
#   uv run python -c "from app.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=

# Случайная строка для подписи сессионных cookie. Сгенерировать:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Уведомления о новых заказах через Telegram-бота (опционально).
# Токен — от @BotFather, chat_id — свой числовой id (например, от @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
